{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankxai/agentic-business-os/schemas/foundry-product-registry.schema.json",
  "title": "Foundry Product Registry",
  "type": "object",
  "required": ["schemaVersion", "lastVerified", "offers"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "lastVerified": { "type": "string", "format": "date" },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "audience",
          "ownerRepo",
          "status",
          "license",
          "priceStatus",
          "checkoutStatus",
          "deliveryStatus",
          "supportStatus",
          "updateStatus",
          "proof",
          "nextGate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "audience": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "ownerRepo": { "type": "string", "minLength": 3 },
          "surface": { "type": ["string", "null"] },
          "status": { "enum": ["live", "validated", "prototype", "proposed", "blocked"] },
          "license": { "type": "string", "minLength": 2 },
          "priceStatus": { "enum": ["free", "verified", "hypothesis", "evaluation", "not-applicable"] },
          "checkoutStatus": { "enum": ["live", "application", "manual", "not-configured", "not-applicable"] },
          "deliveryStatus": { "enum": ["verified", "manual-verified", "prototype", "not-verified"] },
          "supportStatus": { "enum": ["documented", "manual", "proposed", "none"] },
          "updateStatus": { "enum": ["automated-pr", "release-feed", "manual", "proposed", "none"] },
          "proof": { "type": "array", "items": { "type": "string", "minLength": 3 } },
          "nextGate": { "type": "string", "minLength": 3 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
